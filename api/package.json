{
  "name": "@task/api",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#api/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "scripts": {
    "check:types": "tsc --noEmit",
    "check:lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "fix:lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "fix:format": "prettier --write .",
    "fix": "npm run fix:lint && npm run fix:format",
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@task/shared": "file:../packages/shared",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
