{
  "name": "@task/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#web/*": "./src/*"
  },
  "scripts": {
    "check:types": "tsc -b --noEmit",
    "check:lint": "eslint .",
    "fix:lint": "eslint . --fix",
    "fix:format": "prettier --write .",
    "fix": "npm run fix:lint && npm run fix:format",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@task/shared": "file:../packages/shared",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-use": "^17.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
