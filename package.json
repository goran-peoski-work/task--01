{
  "name": "@task/root",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev:shared": "npm run dev --workspace=@task/shared",
    "dev:api": "npm run dev --workspace=@task/api",
    "dev:web": "npm run dev --workspace=@task/web",
    "build:shared": "npm run build --workspace=@task/shared",
    "build:api": "npm run build --workspace=@task/api",
    "build:web": "npm run build --workspace=@task/web",
    "check:types": "npm run build --workspace=@task/shared && npm run check:types --workspace=@task/api --workspace=@task/web",
    "check:lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "check:format": "prettier --check .",
    "check:watch": "onchange -i \"./**/*.{js,jsx,ts,tsx}\" -e \"**/dist/**\" -- npm run check || true",
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "fix:lint": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "fix:format": "prettier --write . --log-level warn",
    "fix:watch": "onchange --delay 10000 -i \"./**/*.{js,jsx,ts,tsx}\" -e \"**/dist/**\" -- npm run fix || true",
    "fix": "npm run fix:lint && npm run fix:format",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "predev": "npm run build:shared",
    "dev": "concurrently --handle-input \"npm run dev:shared\" \"npm run dev:api\" \"npm run dev:web\"",
    "prepare": "node .husky/prepare.script.mjs"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "onchange": "^7.1.0",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
